# Only for the NEW helper service. Never overwrite the shop bot's variables.
SUPPORT_BOT_TOKEN=
SUPPORT_OWNER_ID=
OPENAI_API_KEY=
# Explicit initial test candidates; account availability must be checked live.
SUPPORT_MODEL=gpt-4.1-mini
SUPPORT_AUDIO_MODEL=gpt-4o-transcribe
SUPPORT_STATE_PATH=/data/support.sqlite3
# Empty = no personal chat messages will be processed.
# Test group, then a separate switch for everyone. Do not fill these in git.
# The owner sets SUPPORT_TEST_CHAT_IDS and SUPPORT_AUTO_TEST_CHAT_IDS to the
# chosen test clients. SUPPORT_AUTO_FOR_ALL stays empty until everyone is enabled.
SUPPORT_TEST_CHAT_IDS=
SUPPORT_AUTO_TEST_CHAT_IDS=
SUPPORT_AUTO_TEST_CHAT_ID=
SUPPORT_AUTO_FOR_ALL=
# yes = drafts for every private client go to the owner. AUTO stays test-IDs only.
SUPPORT_DRAFTS_FOR_ALL=
# Required explicit acknowledgement: selected test media goes to OpenAI.
SUPPORT_MEDIA_CONSENT=yes
# Number of OpenAI requests per UTC day, NOT a dollar spending guarantee.
SUPPORT_DAILY_CALL_LIMIT=600
RAILWAY_DOCKERFILE_PATH=support_agent/Dockerfile
# Optional. MUST be a separate SELECT-only role, not the shop's DATABASE_URL.
SHOP_READONLY_DATABASE_URL=
